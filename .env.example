# Database Configuration
DATABASE_URL=postgresql+asyncpg://foodrescue_user:foodrescue_password@localhost:5432/foodrescue
SYNC_DATABASE_URL=postgresql://foodrescue_user:foodrescue_password@localhost:5432/foodrescue

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security Configuration
SECRET_KEY=demo_secret_key_must_be_changed_in_production_extremely_long_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# Environment
ENVIRONMENT=development

# AI / LLM Integration
OPENAI_API_KEY=mock_openai_api_key_for_dev

# Jurisdiction Configuration
DEFAULT_JURISDICTION=ANDHRA_PRADESH
DEFAULT_LANGUAGE=en
