# Database Configuration
DATABASE_URL=postgresql+asyncpg://foodrescue_user:foodrescue_password@localhost:5432/foodrescue
SYNC_DATABASE_URL=postgresql://foodrescue_user:foodrescue_password@localhost:5432/foodrescue

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security Configuration
SECRET_KEY=demo_secret_key_must_be_changed_in_production_extremely_long_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# Environment
ENVIRONMENT=development

# AI / LLM Integration
OPENAI_API_KEY=mock_openai_api_key_for_dev

# Jurisdiction Configuration
DEFAULT_JURISDICTION=ANDHRA_PRADESH
DEFAULT_LANGUAGE=en

# Sessions
SESSION_EXPIRE_MINUTES=480
REMEMBER_ME_EXPIRE_DAYS=7
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900

# Public web app URL (used in email links) and allowed browser origins
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Outgoing email. Leave SMTP_HOST empty to write emails (with links) to the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=FoodRescue <no-reply@foodrescue.org>

# Phone verification stays disabled until an SMS provider is configured.
SMS_PROVIDER=

# Verification document storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Web app (apps/web): where the Next.js server reaches the API
API_URL=http://localhost:8000
# Optional public contact address shown in the site footer
NEXT_PUBLIC_CONTACT_EMAIL=
